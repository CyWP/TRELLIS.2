        <mxCell id="rl7uGPVT0k8NYsay8ons-150" edge="1" parent="1" source="rl7uGPVT0k8NYsay8ons-87" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;" target="rl7uGPVT0k8NYsay8ons-97">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rl7uGPVT0k8NYsay8ons-87" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;strokeColor=#FF2D2D;" value="- Given the ViT patches for conditioning aren&#39;t spatially organized, it may not be necessary to &quot;complete&quot; an input image (essentially doing our target task in 2d) before feeding as input. Perhaps simply nulling/masking those patches&#39; (being the patches with incomplete data) contributions during attention computation.&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;- Alternatively just iterpolate between neighboring patches&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;- If absolutely necessary, first generating fill using Image model possible.&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="370" x="470" y="-90" as="geometry" />
        </mxCell>
        <mxCell id="rl7uGPVT0k8NYsay8ons-93" edge="1" parent="1" source="rl7uGPVT0k8NYsay8ons-89" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="rl7uGPVT0k8NYsay8ons-92">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rl7uGPVT0k8NYsay8ons-89" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#003903;align=left;" value="&lt;b&gt;shape sLat decoder&lt;/b&gt;&lt;br&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;-class: FlexiDualGridVaeDecoder&lt;/div&gt;&lt;div style=&quot;&quot;&gt;- sLat(32 fdims) -&amp;gt; o-voxel (8 fdims)&lt;/div&gt;&lt;div style=&quot;&quot;&gt;- specific fdims have different &quot;meanings&quot; (loc in voxel [0:3], intersection flags[3:6], lerp weights[6:7])&lt;/div&gt;&lt;div style=&quot;&quot;&gt;- o-voxel has many more support points than slat&lt;/div&gt;&lt;div style=&quot;&quot;&gt;- o-voxel -&amp;gt; mesh&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="310" x="2310" y="440" as="geometry" />
        </mxCell>
